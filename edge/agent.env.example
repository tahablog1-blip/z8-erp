# انسخ هذا الملف باسم agent.env بجانب z8_agent.py وعدّل القيم
Z8_SERVER=https://z8masdr.duckdns.org
Z8_AGENT_KEY=z8a_ضع_المفتاح_من_الموقع_هنا

# اختياري (القيم الافتراضية مناسبة)
# Z8_WATCH_STATIONS=1        محطات المراقبة التلقائية للحركة (1 = كاميرات المدخل). الحفر تُقرأ عند الطلب فقط.
# Z8_SCAN_INTERVAL=1         كل كم ثانية لقطة للمقارنة
# Z8_MOTION_LEVEL=12         حساسية الحركة (أقل = أحسّ)
# Z8_VISION_COOLDOWN=2       أقل زمن بين لقطتين مُرسلتين لنفس الكاميرا
# Z8_LOG_FILE=agent.log
